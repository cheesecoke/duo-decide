{
	"cli": {
		"version": ">= 16.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"channel": "development",
			"ios": {
				"simulator": true
			}
		},
		"preview": {
			"distribution": "internal",
			"environment": "preview",
			"channel": "preview",
			"ios": {
				"image": "macos-sequoia-15.6-xcode-26.2"
			}
		},
		"production": {
			"environment": "production",
			"channel": "production",
			"autoIncrement": true,
			"ios": {
				"image": "macos-sequoia-15.6-xcode-26.2"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
